# ==============================================================================
# TP-Link Easy Smart Switch Web-to-SNMP Bridge Configuration
# ==============================================================================

# --- Global / Server Settings ---
APP_HOST=0.0.0.0
WEB_PORT=8080                    # Web Dashboard port (shows real-time stats & SNMP OIDs)
WEB_USER=admin                   # Optional login username for Web Dashboard (leave empty to disable auth)
WEB_PASSWORD=admin123            # Optional login password for Web Dashboard (leave empty to disable auth)
REFRESHED_PAGE=10                # Scrape refresh interval in seconds (Default: 10s)
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR
MOCK_MODE=false                  # Set to true to simulate switches without real hardware

# --- SNMP Agent Configuration (Global defaults for v2c / v3) ---
# Version support: v2c, v3, or both
SNMP_VERSION=both

# SNMP v2c Settings
SNMP_COMMUNITY=public

# SNMP v3 Settings
SNMP_V3_USER=zabbix
# Security Level: authPriv, authNoPriv, noAuthNoPriv
SNMP_V3_SEC_LEVEL=authPriv
# Auth Protocol: SHA, MD5, SHA224, SHA256, SHA384, SHA512
SNMP_V3_AUTH_PROTOCOL=SHA
SNMP_V3_AUTH_PASSPHRASE=authpass123
# Priv Protocol: AES, DES, AES128, AES192, AES256
SNMP_V3_PRIV_PROTOCOL=AES
SNMP_V3_PRIV_PASSPHRASE=privpass123

# --- Dynamic Switch Targets ---
# You can define switches using Method A (individual variables) OR Method B (comma list), or both!

# --- METHOD A: Numbered Targets (Recommended) ---
# Target 1:
SWITCH_1_IP=192.168.88.150
SWITCH_1_USER=admin_1
SWITCH_1_PASS=admin4321
SWITCH_1_SNMP_PORT=161
SWITCH_1_NAME=TL-SG1016PE-Core

# Target 2:
SWITCH_2_IP=192.168.88.151
SWITCH_2_USER=admin
SWITCH_2_PASS=admin123
SWITCH_2_SNMP_PORT=162
SWITCH_2_NAME=TL-SG1016PE-Access1

# Target 3:
SWITCH_3_IP=192.168.88.152
SWITCH_3_USER=admin
SWITCH_3_PASS=admin123
SWITCH_3_SNMP_PORT=163
SWITCH_3_NAME=TL-SG1016PE-Access2

# Target 4:
SWITCH_4_IP=192.168.88.153
SWITCH_4_USER=admin
SWITCH_4_PASS=admin123
SWITCH_4_SNMP_PORT=164
SWITCH_4_NAME=TL-SG1016PE-Access3

# Target 5:
SWITCH_5_IP=192.168.88.154
SWITCH_5_USER=admin
SWITCH_5_PASS=admin123
SWITCH_5_SNMP_PORT=165
SWITCH_5_NAME=TL-SG1016PE-Access4

# Target 6:
SWITCH_6_IP=192.168.88.155
SWITCH_6_USER=admin
SWITCH_6_PASS=admin123
SWITCH_6_SNMP_PORT=166
SWITCH_6_NAME=TL-SG1016PE-Access5

# --- METHOD B: Inline Comma-Separated List (Alternative) ---
# Format: IP:USER:PASSWORD:SNMP_PORT[:NAME],...
# Example:
# SWITCH_TARGETS=192.168.88.150:admin_1:admin4321:161:Core,192.168.88.153:admin:admin123:162:Access3
